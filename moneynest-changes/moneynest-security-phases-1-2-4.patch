+  stripe: { testCustomer: 'missing', liveCustomer: 'ok', liveCancelFails: false, liveSubs: [{ id: 'sub_a', status: 'active' }, { id: 'sub_b', status: 'canceled' }, { id: 'sub_c', status: 'past_due' }] } });

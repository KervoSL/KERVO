# Copy to .env.local for local work. In production, set these in Vercel → Settings → Environment Variables.

# Public URL of the website (canonical URLs, sitemap, Open Graph). Set when the final domain is live.
NEXT_PUBLIC_SITE_URL=

# Public email shown on the site.
NEXT_PUBLIC_CONTACT_EMAIL=

# Where the "Try MoneyNest" buttons point.
NEXT_PUBLIC_MONEYNEST_URL=

# Newsletter sign-ups are stored in Buttondown. Without this key the form shows "not open yet".
BUTTONDOWN_API_KEY=
